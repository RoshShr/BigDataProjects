{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "spotifyfactoryproject"
		},
		"ADFtoLake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADFtoLake'"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"SQLtoADF_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SQLtoADF'"
		},
		"ADFtoLake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://spotifylakestorage.dfs.core.windows.net/"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://spotifylakestorage.dfs.core.windows.net/"
		},
		"SQLtoADF_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "spotifyproject.database.windows.net"
		},
		"SQLtoADF_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "spotifydb"
		},
		"SQLtoADF_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminrosh"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "spotifyfactoryproject_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ADFtoLake_accountKey": {
						"value": "[parameters('ADFtoLake_accountKey')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"SQLtoADF_password": {
						"value": "[parameters('SQLtoADF_password')]"
					},
					"ADFtoLake_properties_typeProperties_url": {
						"value": "[parameters('ADFtoLake_properties_typeProperties_url')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"SQLtoADF_properties_typeProperties_server": {
						"value": "[parameters('SQLtoADF_properties_typeProperties_server')]"
					},
					"SQLtoADF_properties_typeProperties_database": {
						"value": "[parameters('SQLtoADF_properties_typeProperties_database')]"
					},
					"SQLtoADF_properties_typeProperties_userName": {
						"value": "[parameters('SQLtoADF_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}